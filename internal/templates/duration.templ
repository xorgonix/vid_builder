package templates

templ DurationPage(data DurationData) {
	@shell(data.Shell, durationBody(data))
}

templ durationBody(data DurationData) {
	<div class="max-w-6xl mx-auto">
		<div class="flex items-center justify-between mb-4">
			<div>
				<h1 class="text-2xl font-bold">Duration video</h1>
				<p class="opacity-70 text-sm">Enter a prompt and a length (5, 15 or 30 seconds) and get one playable video. Longer videos are built from fixed five-second anchor-to-anchor segments, assembled in order.</p>
			</div>
		</div>

		<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/duration") } class="card bg-base-100 shadow mb-6">
			<div class="card-body gap-3">
				<h2 class="card-title text-base">New duration video</h2>
				<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
				<div class="grid md:grid-cols-2 gap-3">
					<label class="form-control">
						<span class="label-text">Shot (needs an approved start and end frame)</span>
						<select name="shot_id" class="select select-bordered" required>
							for _, sh := range data.Shots {
								<option value={ sh.ShotID } disabled?={ !sh.Endpoints }>{ sh.Title }{ endpointSuffix(sh.Endpoints) }</option>
							}
						</select>
					</label>
					<label class="form-control">
						<span class="label-text">Duration</span>
						<select name="duration" class="select select-bordered">
							<option value="5">5 seconds (1 segment)</option>
							<option value="15">15 seconds (3 segments)</option>
							<option value="30">30 seconds (6 segments)</option>
						</select>
					</label>
					<label class="form-control md:col-span-2">
						<span class="label-text">Workflow (must declare first/last frame bindings)</span>
						<select name="workflow_id" class="select select-bordered" required>
							for _, w := range data.Workflows {
								<option value={ w.ID }>{ w.Name } · { w.Version } ({ w.Status })</option>
							}
						</select>
					</label>
					<label class="form-control">
						<span class="label-text">Positive prompt</span>
						<textarea name="positive" rows="3" class="textarea textarea-bordered" placeholder="she shapes the clay, warm window light"></textarea>
					</label>
					<label class="form-control">
						<span class="label-text">Negative prompt</span>
						<textarea name="negative" rows="3" class="textarea textarea-bordered" placeholder="lowres, blurry"></textarea>
					</label>
				</div>
				<div class="card-actions justify-end">
					<button type="submit" class="btn btn-primary">Queue duration video</button>
				</div>
			</div>
		</form>

		<h2 class="text-lg font-semibold mb-2">Planned and assembled videos</h2>
		for _, asm := range data.Assemblies {
			<div class="card bg-base-100 shadow mb-4">
				<div class="card-body">
					<div class="flex items-center justify-between">
						<div class="font-medium">{ asm.ShotTitle }</div>
						<span class={ "badge", jobStateClass(asm.Status) }>{ asm.Status }</span>
					</div>
					if asm.Error != "" {
						<div class="alert alert-error text-sm my-2">{ asm.Error }</div>
					}
					if asm.HasVideo {
						<video controls preload="metadata" src={ templ.URL(asm.Video.URL) } class="w-full rounded-box border border-base-300 my-2"></video>
					} else {
						<div class="text-sm opacity-60 my-2">The final video appears here once every segment has succeeded.</div>
					}
					<div class="overflow-x-auto">
						<table class="table table-sm">
							<thead><tr><th>#</th><th>Status</th><th>Preview</th><th>Error</th><th></th></tr></thead>
							<tbody>
								for _, seg := range asm.Segments {
									<tr>
										<td>{ seg.Index + 1 }</td>
										<td><span class={ "badge badge-sm", jobStateClass(seg.Status) }>{ seg.Status }</span></td>
										<td>
											if seg.HasFile {
												@durationSegmentMedia(seg.Asset)
											}
										</td>
										<td class="text-xs text-error max-w-xs truncate">{ seg.Error }</td>
										<td>
											if seg.Status == "failed" || seg.Status == "pending" {
												<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/duration/segments/" + seg.ID + "/retry") }>
													<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
													<button type="submit" class="btn btn-xs">Retry</button>
												</form>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		}
		if len(data.Assemblies) == 0 {
			<div class="card bg-base-100 shadow"><div class="card-body opacity-60 text-sm">No duration videos planned yet.</div></div>
		}
	</div>
}

templ durationSegmentMedia(a AssetView) {
	if IsVideoAsset(a) {
		<video controls preload="metadata" src={ templ.URL(a.URL) } class="w-32 rounded"></video>
	} else {
		<img src={ templ.URL(a.URL) } class="w-20 rounded" alt="segment preview"/>
	}
}

func endpointSuffix(ok bool) string {
	if ok {
		return " — endpoints ready"
	}
	return " — endpoints missing"
}
