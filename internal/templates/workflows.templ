package templates

templ WorkflowsPage(data WorkflowsData) {
	@shell(data.Shell, workflowsBody(data))
}

templ workflowsBody(data WorkflowsData) {
	<div class="max-w-5xl mx-auto">
		<h1 class="text-2xl font-bold mb-1">Workflows</h1>
		<p class="opacity-70 text-sm mb-4">Occasional production configuration. Graphs are authored and tested in ComfyUI, exported in API format, then imported as immutable versions.</p>
		<div class="overflow-x-auto card bg-base-100 shadow mb-6">
			<table class="table">
				<thead><tr><th>Name</th><th>Task</th><th>Source</th><th>Version status</th><th>Bindings</th><th></th></tr></thead>
				<tbody>
					for _, w := range data.Workflows {
						<tr>
							<td><div class="font-medium">{ w.Name }</div><div class="text-xs opacity-60 font-mono">{ w.Slug }</div></td>
							<td>{ w.Task }</td>
							<td><span class="badge badge-ghost badge-sm">{ w.Source }</span></td>
							<td><span class={ "badge badge-sm", workflowStatusClass(w.VersionStatus) }>{ w.VersionStatus }</span></td>
							<td>{ w.Bindings }</td>
							<td>
								if w.VersionID != "" {
									<a class="btn btn-xs" href={ templ.URL("/w/" + data.Shell.CurrentWorkspace.ID + "/workflow-versions/" + w.VersionID) }>Bindings</a>
								}
							</td>
						</tr>
					}
					if len(data.Workflows) == 0 {
						<tr><td colspan="6" class="opacity-60">No workflows available.</td></tr>
					}
				</tbody>
			</table>
		</div>

		<div class="card bg-base-100 shadow">
			<div class="card-body">
				<h2 class="card-title text-base">Import a ComfyUI API-format workflow</h2>
				<p class="text-xs opacity-70">Export your tested graph from ComfyUI in API format, then import it here. Importing is immutable: editing the graph in ComfyUI requires a new import.</p>
				<form method="post" action={ templ.URL("/w/" + data.Shell.CurrentWorkspace.ID + "/workflows/import") } enctype="multipart/form-data" class="flex flex-col gap-2 mt-2">
					<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
						<label class="form-control"><span class="label-text mb-1">Name</span><input class="input input-bordered input-sm" name="name" placeholder="My SDXL workflow" required/></label>
						<label class="form-control"><span class="label-text mb-1">Task</span>
							<select class="select select-bordered select-sm" name="task">
								<option value="image">image</option>
								<option value="first_last_video">first_last_video</option>
							</select>
						</label>
					</div>
					<label class="form-control"><span class="label-text mb-1">Graph file (API JSON)</span><input type="file" class="file-input file-input-bordered file-input-sm" name="graph" accept=".json,application/json"/></label>
					<label class="form-control"><span class="label-text mb-1">…or paste API JSON</span><textarea class="textarea textarea-bordered font-mono text-xs" name="graph_json" rows="5" placeholder='{"1":{"class_type":"...","inputs":{...}}}'></textarea></label>
					<button class="btn btn-primary btn-sm self-end" type="submit">Import as immutable draft</button>
				</form>
			</div>
		</div>
	</div>
}

func workflowStatusClass(status string) string {
	switch status {
	case "validated":
		return "badge-success"
	case "invalid":
		return "badge-error"
	case "retired":
		return "badge-ghost"
	default:
		return "badge-warning"
	}
}