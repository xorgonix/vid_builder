package templates

templ BlockingPage(data BlockingEditorData) {
	@shell(data.Shell, blockingBody(data))
}

templ blockingBody(data BlockingEditorData) {
	<script src="/static/blocking.js" defer></script>
	<div class="max-w-7xl mx-auto" id="blocking-canvas">
		<div class="flex items-start justify-between mb-4 flex-wrap gap-2">
			<div>
				<h1 class="text-2xl font-bold">Blocking · { data.Shot.Title }</h1>
				<p class="opacity-70 text-sm">{ data.Shot.Purpose }</p>
			</div>
			<div class="flex gap-2">
				<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/shots/" + data.Shot.ID + "/blocking/suggest") }>
					<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
					<button class="btn btn-sm btn-secondary" type="submit">Suggest blocking</button>
				</form>
				<a class="btn btn-sm" href={ templ.URL(data.Shell.VideoBase() + "/shots/" + data.Shot.ID) }>Shot inspector</a>
			</div>
		</div>
		<div class="grid gap-4 lg:grid-cols-12">
			<div class="lg:col-span-5">
				@blockingSide(data, data.Start, "start", data.StartSVG)
			</div>
			<div class="lg:col-span-2">
				<div class="card bg-base-100 shadow h-full">
					<div class="card-body p-3">
						<h2 class="card-title text-sm">Detected change</h2>
						<ul class="text-xs flex flex-col gap-1">
							for _, a := range data.Analysis {
								<li>• { a }</li>
							}
						</ul>
					</div>
				</div>
			</div>
			<div class="lg:col-span-5">
				@blockingSide(data, data.End, "end", data.EndSVG)
			</div>
		</div>
	</div>
}

templ blockingSide(data BlockingEditorData, b BlockingView, role string, fallbackSVG string) {
	<div class="card bg-base-100 shadow blocking-editor" data-role={ role }>
		<div class="card-body p-3">
			<div class="flex items-center justify-between">
				<h2 class="card-title text-sm uppercase">{ role }</h2>
				if b.Exists {
					<span class="badge badge-ghost badge-sm">v{ b.Version } · { b.Source }</span>
				} else {
					<span class="badge badge-warning badge-sm">not set</span>
				}
			</div>
			<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/shots/" + data.Shot.ID + "/blocking/" + role) }>
				<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
				<input type="hidden" name="_method" value="PATCH"/>
				<textarea class="blocking-state hidden">{ b.SpecJSON }</textarea>
				<div class="blocking-canvas rounded-box overflow-hidden border border-base-300 bg-base-300/20">@templ.Raw(fallbackSVG)</div>
				<div class="blocking-controls flex flex-col gap-1 mt-3"></div>
				<details class="mt-2">
					<summary class="cursor-pointer text-xs opacity-70">Edit as JSON (works without JavaScript)</summary>
					<textarea class="blocking-textarea textarea textarea-bordered w-full font-mono text-xs mt-1" name="spec_json" rows="6">{ b.SpecJSON }</textarea>
				</details>
				<div class="card-actions justify-end mt-2">
					<button class="btn btn-sm btn-primary blocking-save" type="submit">Save { role } blocking</button>
				</div>
			</form>
			<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/shots/" + data.Shot.ID + "/blocking/" + role + "/copy") } class="mt-1">
				<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
				<button class="btn btn-xs btn-ghost" type="submit">Duplicate from opposite endpoint</button>
			</form>
		</div>
	</div>
}