package templates

templ CandidatesPage(data CandidatesData) {
	@shell(data.Shell, candidatesBody(data))
}

templ candidatesBody(data CandidatesData) {
	<div class="max-w-7xl mx-auto">
		<div class="flex items-center justify-between mb-4">
			<div>
				<h1 class="text-2xl font-bold">Candidates · { data.Shot.Title } · { data.RoleLabel }</h1>
				<p class="opacity-70 text-sm">Compare full-size candidates and their receipts. Choose from the image, not the thumbnail.</p>
			</div>
			<a class="btn btn-sm" href={ templ.URL(data.Shell.VideoBase() + "/review") }>Review</a>
		</div>
		if len(data.Assets) == 0 {
			<div class="alert"><span>No candidates for this role yet.</span></div>
		}
		<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
			for _, a := range data.Assets {
				<div class={ "card bg-base-100 shadow", templ.KV("border-2 border-primary", a.ID == data.SelectedID) }>
					<div class="card-body p-3">
						<div class="flex items-center justify-between">
							<a href={ templ.URL(a.URL) } target="_blank" rel="noopener" class="link link-hover text-xs font-mono">{ shortID(a.ID) }</a>
							<div class="flex gap-1">
								if a.ID == data.SelectedID {
									<span class="badge badge-primary badge-sm">selected</span>
								}
								if a.Approval != "" {
									<span class={ "badge badge-sm", approvalClass(a.Approval) }>{ a.Approval }</span>
								}
							</div>
						</div>
						<a href={ templ.URL(a.URL) } target="_blank" rel="noopener">
							<img src={ templ.URL(ImgSrc(a)) } alt={ "Candidate " + shortID(a.ID) } class="w-full rounded"/>
						</a>
						<table class="table table-xs mt-1">
							<tbody>
								<tr><td class="opacity-60">Model</td><td class="font-mono text-xs">{ a.Model }</td></tr>
								<tr><td class="opacity-60">Seed</td><td class="font-mono text-xs">{ a.Seed }</td></tr>
								<tr><td class="opacity-60">Workflow</td><td class="font-mono text-xs">{ shortSHA(a.WorkflowSHA) }</td></tr>
								<tr><td class="opacity-60">Duration</td><td class="text-xs">{ a.Duration }</td></tr>
								<tr><td class="opacity-60">Checksum</td><td class="font-mono text-xs">{ shortSHA(a.Checksum) }</td></tr>
							</tbody>
						</table>
						<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/shots/" + data.Shot.ID + "/selections") }>
							<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
							<input type="hidden" name="role" value={ data.Role }/>
							<input type="hidden" name="asset_id" value={ a.ID }/>
							<button class="btn btn-sm btn-primary w-full" type="submit">Select</button>
						</form>
						<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/assets/" + a.ID + "/approvals") }>
							<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
							<input type="hidden" name="decision" value="approve"/>
							<button class="btn btn-xs btn-success w-full" type="submit">Approve</button>
						</form>
						<details>
							<summary class="cursor-pointer text-xs">Reject / exception / assess…</summary>
							<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/assets/" + a.ID + "/approvals") } class="mt-1">
								<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
								<textarea class="textarea textarea-bordered w-full text-xs mb-1" name="reason" rows="2" placeholder="Reason (required for reject/exception)"></textarea>
								<div class="flex gap-1">
									<button class="btn btn-xs btn-error" type="submit" name="decision" value="reject">Reject</button>
									<button class="btn btn-xs btn-warning" type="submit" name="decision" value="approve_with_exception">Exception</button>
								</div>
							</form>
							<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/assets/" + a.ID + "/assessments") } class="mt-1">
								<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
								<input class="input input-bordered input-xs w-full mb-1" name="summary" placeholder="Assessment note"/>
								<div class="flex gap-1">
									<button class="btn btn-xs" type="submit" name="status" value="pass">Pass</button>
									<button class="btn btn-xs" type="submit" name="status" value="review">Review</button>
									<button class="btn btn-xs" type="submit" name="status" value="fail">Fail</button>
								</div>
							</form>
						</details>
					</div>
				</div>
			}
		</div>
	</div>
}

func shortSHA(s string) string {
	if len(s) <= 12 {
		return s
	}
	return s[:12]
}