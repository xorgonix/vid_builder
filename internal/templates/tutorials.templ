package templates

templ TutorialsPage(data TutorialsData) {
	@shell(data.Shell, tutorialsBody(data))
}

templ tutorialsBody(data TutorialsData) {
	<div class="max-w-4xl mx-auto">
		<div class="mb-6">
			<h1 class="text-2xl font-bold">Guided tours</h1>
			<p class="opacity-70 text-sm">These tours drive the real interface: they highlight controls, fill fields and perform the operations for you while a caption explains each step. You can pause, step forward and back, or exit at any time.</p>
		</div>
		<div class="grid gap-4">
			for _, t := range data.Tutorials {
				<div class="card bg-base-100 shadow">
					<div class="card-body">
						<div class="flex items-start justify-between gap-4">
							<div>
								<h2 class="card-title text-base">{ t.Title }</h2>
								<p class="text-sm opacity-70 mt-1">{ t.Summary }</p>
								<div class="text-xs opacity-60 mt-2">{ t.Steps } steps
									if t.VideoScope {
										· run with a project and video open
									}
								</div>
							</div>
							<a class="btn btn-primary btn-sm" data-tutorial-start={ t.Slug } href={ tutorialStartHref(t) }>Start tour</a>
						</div>
					</div>
				</div>
			}
		</div>
		<div class="alert alert-info mt-6 text-sm">
			<span>The setup tour creates its own “Tutorial Studio” workspace and a project inside it, so your existing work is never touched. Tours never queue image or video generation.</span>
		</div>
	</div>
}

func tutorialStartHref(t TutorialView) string {
	route := t.StartRoute
	if route == "" {
		route = "/workspaces"
	}
	return route + "?tour=" + t.Slug + "&step=0"
}
