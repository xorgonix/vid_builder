package templates

templ ProposalPage(data ProposalData) {
	@shell(data.Shell, proposalBody(data))
}

templ proposalBody(data ProposalData) {
	<div class="max-w-4xl mx-auto">
		<div class="flex items-center justify-between mb-4">
			<div>
				<h1 class="text-2xl font-bold">Proposal</h1>
				<p class="opacity-70 text-sm">
					<span class="badge badge-ghost badge-sm mr-1">{ data.Proposal.Type }</span>
					<span class={ "badge badge-sm", proposalStatusClass(data.Proposal.Status) }>{ data.Proposal.Status }</span>
				</p>
			</div>
			<a class="btn btn-sm btn-ghost" href={ templ.URL(data.Shell.VideoBase() + "/develop") }>Back to Develop</a>
		</div>
		<div class="alert alert-info mb-4">
			<span>AI proposes; you decide. Select the fields you accept, then apply. Nothing changes until you apply it.</span>
		</div>
		if data.IsBrief || data.IsPrompt {
			<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/proposals/" + data.Proposal.ID + "/apply") } class="card bg-base-100 shadow">
				<div class="card-body">
					<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
					for _, f := range data.Fields {
						<div class="form-control border-b border-base-300 py-2">
							<label class="label cursor-pointer justify-start gap-2 mb-1">
								<input type="checkbox" class="checkbox checkbox-sm" name={ "c_" + f.Key } checked?={ f.Checked }/>
								<span class="label-text font-semibold">{ f.Label }</span>
							</label>
							<textarea class="textarea textarea-bordered w-full font-mono text-sm" name={ "f_" + f.Key } rows="2">{ f.Value }</textarea>
						</div>
					}
					<div class="card-actions justify-end mt-3">
						<button class="btn btn-ghost" type="submit" formaction={ templ.URL(data.Shell.VideoBase() + "/proposals/" + data.Proposal.ID + "/reject") }>Reject</button>
						<button class="btn btn-primary" type="submit">Apply selected fields</button>
					</div>
				</div>
			</form>
		}
		if data.IsBlocking {
			<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/proposals/" + data.Proposal.ID + "/apply") }>
				<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
				<div class="card bg-base-100 shadow">
					<div class="card-body">
						<p class="opacity-80 text-sm">{ data.Blocking.Summary }</p>
						<div class="grid grid-cols-2 gap-3 mt-2">
							<label class="cursor-pointer">
								<span class="label-text flex items-center gap-2 mb-1"><input type="checkbox" class="checkbox checkbox-sm" name="c_start" checked="checked"/> Start blocking</span>
								<div class="rounded-box overflow-hidden border border-base-300">@templ.Raw(data.Blocking.StartSVG)</div>
							</label>
							<label class="cursor-pointer">
								<span class="label-text flex items-center gap-2 mb-1"><input type="checkbox" class="checkbox checkbox-sm" name="c_end" checked="checked"/> End blocking</span>
								<div class="rounded-box overflow-hidden border border-base-300">@templ.Raw(data.Blocking.EndSVG)</div>
							</label>
						</div>
						<div class="card-actions justify-end mt-3">
							<button class="btn btn-ghost" type="submit" formaction={ templ.URL(data.Shell.VideoBase() + "/proposals/" + data.Proposal.ID + "/reject") }>Reject</button>
							<button class="btn btn-primary" type="submit">Apply blocking</button>
						</div>
					</div>
				</div>
			</form>
		}
		if data.IsOutline {
			<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/proposals/" + data.Proposal.ID + "/apply") }>
				<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
				<div class="card bg-base-100 shadow">
					<div class="card-body">
						<p class="opacity-80 text-sm">{ data.Outline.Summary }</p>
						@outlinePreview(data.Outline)
						<div class="card-actions justify-end mt-3">
							<button class="btn btn-ghost" type="submit" formaction={ templ.URL(data.Shell.VideoBase() + "/proposals/" + data.Proposal.ID + "/reject") }>Reject</button>
							<button class="btn btn-primary" type="submit">Apply whole outline</button>
						</div>
					</div>
				</div>
			</form>
		}
		if data.IsBeats {
			<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/proposals/" + data.Proposal.ID + "/apply") }>
				<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
				<div class="card bg-base-100 shadow">
					<div class="card-body">
						<p class="opacity-80 text-sm">Proposed beats for one scene. Untick anything you do not accept; edit before applying.</p>
						for _, b := range data.Beats {
							<div class="border-b border-base-300 py-2">
								<label class="label cursor-pointer justify-start gap-2 mb-1">
									<input type="checkbox" class="checkbox checkbox-sm" name={ "c_beat_" + itoaT(b.Index) } checked="checked"/>
									<span class="label-text font-semibold">Beat { itoaT(b.Index + 1) }</span>
								</label>
								<input class="input input-bordered input-sm w-full mb-2" name={ "f_beat_title_" + itoaT(b.Index) } value={ b.Title }/>
								<div class="grid grid-cols-2 gap-2">
									<textarea class="textarea textarea-bordered text-sm" name={ "f_beat_purpose_" + itoaT(b.Index) } rows="1" placeholder="purpose">{ b.Purpose }</textarea>
									<textarea class="textarea textarea-bordered text-sm" name={ "f_beat_trigger_" + itoaT(b.Index) } rows="1" placeholder="trigger">{ b.Trigger }</textarea>
									<textarea class="textarea textarea-bordered text-sm" name={ "f_beat_action_" + itoaT(b.Index) } rows="1" placeholder="action">{ b.Action }</textarea>
									<textarea class="textarea textarea-bordered text-sm" name={ "f_beat_reaction_" + itoaT(b.Index) } rows="1" placeholder="reaction">{ b.Reaction }</textarea>
									<textarea class="textarea textarea-bordered text-sm" name={ "f_beat_state_" + itoaT(b.Index) } rows="1" placeholder="resulting state">{ b.ResultingState }</textarea>
									<textarea class="textarea textarea-bordered text-sm" name={ "f_beat_effect_" + itoaT(b.Index) } rows="1" placeholder="audience effect">{ b.AudienceEffect }</textarea>
								</div>
							</div>
						}
						<div class="card-actions items-center justify-end mt-3">
							<input class="input input-bordered input-sm mr-auto w-56" name="reason" placeholder="Rejection reason (optional)"/>
							<button class="btn btn-ghost" type="submit" formaction={ templ.URL(data.Shell.VideoBase() + "/proposals/" + data.Proposal.ID + "/reject") }>Reject</button>
							<button class="btn" type="submit" name="apply_all" value="1">Apply all</button>
							<button class="btn btn-primary" type="submit">Apply selected beats</button>
						</div>
					</div>
				</div>
			</form>
		}
		if data.IsShots {
			<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/proposals/" + data.Proposal.ID + "/apply") }>
				<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
				<div class="card bg-base-100 shadow">
					<div class="card-body">
						<p class="opacity-80 text-sm">Proposed shots for one beat. One shot is a valid answer. Edit or untick before applying.</p>
						for _, sh := range data.Breakdown {
							<div class="border-b border-base-300 py-2">
								<label class="label cursor-pointer justify-start gap-2 mb-1">
									<input type="checkbox" class="checkbox checkbox-sm" name={ "c_shot_" + itoaT(sh.Index) } checked="checked"/>
									<span class="label-text font-semibold">Shot { itoaT(sh.Index + 1) }</span>
									<span class="badge badge-ghost badge-sm">{ sh.GenerationMethod }</span>
									<span class="badge badge-ghost badge-sm">{ sh.DurationMs / 1000 }s</span>
								</label>
								<input class="input input-bordered input-sm w-full mb-2" name={ "f_shot_title_" + itoaT(sh.Index) } value={ sh.Title }/>
								<textarea class="textarea textarea-bordered text-sm w-full mb-2" name={ "f_shot_purpose_" + itoaT(sh.Index) } rows="1" placeholder="narrative purpose">{ sh.NarrativePurpose }</textarea>
								<textarea class="textarea textarea-bordered text-sm w-full mb-2" name={ "f_shot_treatment_" + itoaT(sh.Index) } rows="2" placeholder="treatment">{ shotTreatmentText(sh) }</textarea>
								<p class="text-xs opacity-70">Must notice: { sh.MustNotice } · Start: { sh.StartState } · Change: { sh.VisibleChange } · End: { sh.EndState }</p>
							</div>
						}
						<div class="card-actions items-center justify-end mt-3">
							<input class="input input-bordered input-sm mr-auto w-56" name="reason" placeholder="Rejection reason (optional)"/>
							<button class="btn btn-ghost" type="submit" formaction={ templ.URL(data.Shell.VideoBase() + "/proposals/" + data.Proposal.ID + "/reject") }>Reject</button>
							<button class="btn" type="submit" name="apply_all" value="1">Apply all</button>
							<button class="btn btn-primary" type="submit">Apply selected shots</button>
						</div>
					</div>
				</div>
			</form>
		}
		if len(data.Current) > 0 {
			<div class="card bg-base-200 shadow mt-3">
				<div class="card-body">
					<h2 class="card-title text-sm">Current structure (compare before applying)</h2>
					<ul class="text-xs opacity-80 flex flex-col gap-1">
						for _, line := range data.Current {
							<li>• { line }</li>
						}
					</ul>
				</div>
			</div>
		}
		if data.IsOutline || data.IsBeats || data.IsShots || data.IsBrief {
			<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/proposals/" + data.Proposal.ID + "/regenerate") } class="card bg-base-100 shadow mt-3">
				<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
				<div class="card-body">
					<h2 class="card-title text-sm">Regenerate from feedback</h2>
					<textarea class="textarea textarea-bordered w-full" name="feedback" rows="2" placeholder="What should change? (optional but recommended)"></textarea>
					<div class="card-actions justify-end mt-2">
						<button class="btn btn-sm" type="submit">Regenerate</button>
					</div>
				</div>
			</form>
		}
	</div>
}
func shotTreatmentText(sh BreakdownShotView) string {
	out := ""
	if sh.Framing != "" {
		out += "Framing: " + sh.Framing + "\n"
	}
	if sh.VisibleChange != "" {
		out += "Change: " + sh.VisibleChange + "\n"
	}
	if sh.GenerationMethod != "" {
		out += "Method: " + sh.GenerationMethod + "\n"
	}
	if sh.Justification != "" {
		out += "Why: " + sh.Justification
	}
	return out
}

templ outlinePreview(view *OutlineView) {
	if view == nil {
		return
	}
	<div class="flex flex-col gap-3 mt-2">
		for _, sec := range view.Sections {
			<div class="border border-base-300 rounded-box p-3">
				<div class="font-semibold">{ sec.Title } <span class="text-xs opacity-60">{ sec.BudgetMs / 1000 }s</span></div>
				<p class="text-xs opacity-70">{ sec.Purpose }</p>
				for _, sc := range sec.Scenes {
					<div class="ml-4 mt-2 border-l border-base-300 pl-3">
						<div class="text-sm font-medium">{ sc.Title } <span class="badge badge-ghost badge-xs">{ sc.Pace }</span></div>
						<p class="text-xs opacity-70">{ sc.Synopsis }</p>
						<ul class="mt-1 flex flex-col gap-1">
							for _, sh := range sc.Shots {
								<li class="text-xs">• <span class="font-medium">{ sh.Title }</span> — { sh.Purpose } <span class="opacity-60">({ sh.DurationMs / 1000 }s)</span></li>
							}
						</ul>
					</div>
				}
			</div>
		}
	</div>
}

templ BriefHistoryPage(data BriefHistoryData) {
	@shell(data.Shell, briefHistoryBody(data))
}

templ briefHistoryBody(data BriefHistoryData) {
	<div class="max-w-4xl mx-auto">
		<div class="flex items-center justify-between mb-4">
			<h1 class="text-2xl font-bold">Brief history</h1>
			<a class="btn btn-sm btn-ghost" href={ templ.URL(data.Shell.VideoBase() + "/develop") }>Back to Develop</a>
		</div>
		<div class="flex flex-col gap-3">
			for _, v := range data.Versions {
				<div class="card bg-base-100 shadow">
					<div class="card-body">
						<div class="flex items-center gap-2">
							<span class="badge badge-ghost">v{ v.Version }</span>
							if v.Version == 1 {
								<span class="badge badge-primary badge-sm">first</span>
							}
						</div>
						<dl class="text-sm grid grid-cols-[8rem_1fr] gap-x-2 gap-y-1 mt-2">
							@briefRow("Premise", v.Premise)
							@briefRow("Theme", v.Theme)
							@briefRow("Audience", v.Audience)
							@briefRow("Desired reaction", v.DesiredReaction)
							@briefRow("Visual style", v.VisualStyle)
						</dl>
					</div>
				</div>
			}
		</div>
	</div>
}