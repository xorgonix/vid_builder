package templates

templ BiblePage(data BibleData) {
	@shell(data.Shell, bibleBody(data))
}

templ bibleBody(data BibleData) {
	<div class="max-w-5xl mx-auto">
		<div class="flex items-center justify-between mb-4">
			<div>
				<h1 class="text-2xl font-bold">Project Bible</h1>
				<p class="opacity-70 text-sm">Reusable characters, locations and style rules that maintain continuity.</p>
			</div>
			<a class="btn btn-sm" href={ templ.URL("/w/" + data.Shell.CurrentWorkspace.ID + "/projects/" + data.Project.ID) }>Project</a>
		</div>
		<div class="grid gap-4 lg:grid-cols-3">
			<div class="card bg-base-100 shadow">
				<div class="card-body">
					<h2 class="card-title text-base">Characters</h2>
					<ul class="text-sm divide-y divide-base-300">
						for _, c := range data.Characters {
							<li class="py-1"><span class="font-medium">{ c.Name }</span><span class="opacity-70"> — { c.Description }</span></li>
						}
					</ul>
					<form method="post" action={ templ.URL("/w/" + data.Shell.CurrentWorkspace.ID + "/projects/" + data.Project.ID + "/characters") } class="mt-3 flex flex-col gap-2">
						<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
						<input class="input input-bordered input-sm" name="name" placeholder="Character name" required/>
						<textarea class="textarea textarea-bordered text-sm" name="description" rows="2" placeholder="Description / invariants"></textarea>
						<button class="btn btn-sm" type="submit">Add character</button>
					</form>
				</div>
			</div>
			<div class="card bg-base-100 shadow">
				<div class="card-body">
					<h2 class="card-title text-base">Locations</h2>
					<ul class="text-sm divide-y divide-base-300">
						for _, l := range data.Locations {
							<li class="py-1"><span class="font-medium">{ l.Name }</span><span class="opacity-70"> — { l.Description }</span></li>
						}
					</ul>
					<form method="post" action={ templ.URL("/w/" + data.Shell.CurrentWorkspace.ID + "/projects/" + data.Project.ID + "/locations") } class="mt-3 flex flex-col gap-2">
						<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
						<input class="input input-bordered input-sm" name="name" placeholder="Location name" required/>
						<textarea class="textarea textarea-bordered text-sm" name="description" rows="2" placeholder="Description / continuity"></textarea>
						<button class="btn btn-sm" type="submit">Add location</button>
					</form>
				</div>
			</div>
			<div class="card bg-base-100 shadow">
				<div class="card-body">
					<h2 class="card-title text-base">Style rules</h2>
					<ul class="text-sm divide-y divide-base-300">
						for _, r := range data.StyleRules {
							<li class="py-1"><span class="badge badge-ghost badge-xs mr-1">{ r.Category }</span>{ r.Text }</li>
						}
					</ul>
					<form method="post" action={ templ.URL("/w/" + data.Shell.CurrentWorkspace.ID + "/projects/" + data.Project.ID + "/style-rules") } class="mt-3 flex flex-col gap-2">
						<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
						<input class="input input-bordered input-sm" name="category" placeholder="Category"/>
						<textarea class="textarea textarea-bordered text-sm" name="rule_text" rows="2" placeholder="Rule" required></textarea>
						<button class="btn btn-sm" type="submit">Add rule</button>
					</form>
				</div>
			</div>
		</div>
	</div>
}