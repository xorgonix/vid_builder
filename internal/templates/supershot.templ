package templates

func endpointSuffix(ok bool) string {
	if ok {
		return " — endpoints ready"
	}
	return " — endpoints missing"
}

templ SuperShotListPage(data SuperShotListData) {
	@shell(data.Shell, superShotListBody(data))
}

templ superShotListBody(data SuperShotListData) {
	<div class="max-w-6xl mx-auto">
		<div class="flex items-center justify-between mb-4">
			<div>
				<h1 class="text-2xl font-bold">Super Shots</h1>
				<p class="opacity-70 text-sm">One perceived shot, 2.0–30.0 seconds, generated directly or as an ordered chain of adjacent segments.</p>
			</div>
			<a class="btn btn-primary btn-sm" href={ templ.URL(data.Shell.VideoBase() + "/super-shots/new") }>New Super Shot</a>
		</div>
		<div class="grid gap-3">
			if data.LegacyCount > 0 {
				<div class="alert alert-error text-sm">
					{ data.LegacyCount } legacy plan(s) reuse the shot's outer endpoints for every segment. They are marked and require re-planning; their outputs are preserved.
				</div>
			}
			for _, p := range data.Plans {
				<a class="card bg-base-100 shadow card-body hover:border hover:border-primary" href={ templ.URL(data.Shell.VideoBase() + "/super-shots/" + p.ID) }>
					<div class="flex items-center justify-between">
						<div>
							<div class="font-medium">{ p.ShotTitle }</div>
							<div class="text-xs opacity-70">{ p.Strategy } · requested { MSecs(p.RequestedDurationMS) }s · planned { MSecs(p.PlannedDurationMS) }s · { p.ContextMode }</div>
						</div>
						<div class="flex items-center gap-2">
							if p.LegacyInvalid {
								<span class="badge badge-error badge-sm">legacy invalid</span>
							}
							<span class={ "badge badge-sm", jobStateClass(p.Status) }>{ p.Status }</span>
						</div>
					</div>
				</a>
			}
			if len(data.Plans) == 0 {
				<div class="card bg-base-100 shadow"><div class="card-body opacity-60 text-sm">No Super Shots yet.</div></div>
			}
		</div>
	</div>
}

templ SuperShotFormPage(data SuperShotFormData) {
	@shell(data.Shell, superShotFormBody(data))
}

templ superShotFormBody(data SuperShotFormData) {
	<div class="max-w-3xl mx-auto">
		<h1 class="text-2xl font-bold mb-1">New Super Shot</h1>
		<p class="opacity-70 text-sm mb-4">Duration defaults to the shot's target. 5, 15 and 30 seconds are presets, not limits.</p>
		<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/super-shots/plan") } class="card bg-base-100 shadow">
			<div class="card-body gap-3">
				<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
				<label class="form-control">
					<span class="label-text">Shot (needs approved start and end images)</span>
					<select name="shot_id" class="select select-bordered" required>
						for _, sh := range data.Shots {
							<option value={ sh.ShotID } selected?={ sh.ShotID == data.PreselectShotID } disabled?={ !sh.Endpoints }>{ sh.Title }{ endpointSuffix(sh.Endpoints) }</option>
						}
					</select>
				</label>
				<div class="grid md:grid-cols-2 gap-3">
					<label class="form-control">
						<span class="label-text">Duration (seconds)</span>
						<input id="ss-duration" name="duration_s" type="number" min="2" max="30" step="0.1" class="input input-bordered" value={ MSecs(data.DefaultDurationMS) } required/>
					</label>
					<div class="form-control">
						<span class="label-text">Presets</span>
						<div class="flex gap-1 pt-1">
							<button type="button" class="btn btn-xs" onclick="document.getElementById('ss-duration').value='5'">5s</button>
							<button type="button" class="btn btn-xs" onclick="document.getElementById('ss-duration').value='15'">15s</button>
							<button type="button" class="btn btn-xs" onclick="document.getElementById('ss-duration').value='30'">30s</button>
						</div>
					</div>
					<label class="form-control">
						<span class="label-text">Workflow</span>
						<select name="workflow_id" class="select select-bordered" required>
							for _, w := range data.Workflows {
								<option value={ w.ID }>{ w.Name } · { w.Version }</option>
							}
						</select>
					</label>
					<label class="form-control">
						<span class="label-text">Strategy</span>
						<select name="strategy" class="select select-bordered">
							<option value="auto">Auto</option>
							<option value="direct">Direct</option>
							<option value="chained">Chained</option>
						</select>
					</label>
					<label class="form-control">
						<span class="label-text">Motion continuity</span>
						<select name="context_mode" class="select select-bordered">
							<option value="anchor_only">Shared images (anchor-only)</option>
							<option value="tail_frames" disabled>Previous frames — unavailable</option>
							<option value="native_latent" disabled>Native latent — unavailable</option>
						</select>
					</label>
					<label class="form-control">
						<span class="label-text">Camera (optional)</span>
						<input name="camera" class="input input-bordered" placeholder="slow push in"/>
					</label>
					<label class="form-control">
						<span class="label-text">Video model profile (optional)</span>
						<select name="model_profile_id" class="select select-bordered">
							<option value="">None</option>
							for _, p := range data.Profiles {
								<option value={ p.ID }>{ p.Name } · { p.Checkpoint }</option>
							}
						</select>
					</label>
					<label class="form-control">
						<span class="label-text">Image workflow (for intermediate images)</span>
						<select name="image_workflow_id" class="select select-bordered">
							<option value="">Auto (first image workflow)</option>
							for _, w := range data.ImageWorkflows {
								<option value={ w.ID }>{ w.Name } · { w.Version }</option>
							}
						</select>
					</label>
					<label class="form-control">
						<span class="label-text">Image model profile (optional)</span>
						<select name="image_profile_id" class="select select-bordered">
							<option value="">None</option>
							for _, p := range data.Profiles {
								<option value={ p.ID }>{ p.Name } · { p.Checkpoint }</option>
							}
						</select>
					</label>
				</div>
				<label class="form-control">
					<span class="label-text">Movement prompt (the complete shot's action)</span>
					<textarea name="positive" rows="2" class="textarea textarea-bordered" placeholder="Person walks to a chair, turns and sits"></textarea>
				</label>
				<label class="form-control">
					<span class="label-text">Negative prompt</span>
					<textarea name="negative" rows="2" class="textarea textarea-bordered" placeholder="lowres, blurry"></textarea>
				</label>
				<div class="grid md:grid-cols-2 gap-3">
					<label class="form-control">
						<span class="label-text">Start state (optional)</span>
						<input name="start_state" class="input input-bordered" placeholder="standing by the chair"/>
					</label>
					<label class="form-control">
						<span class="label-text">End state (optional)</span>
						<input name="end_state" class="input input-bordered" placeholder="seated, hands on knees"/>
					</label>
				</div>
				<label class="form-control">
					<span class="label-text">Intermediate state descriptions (one per line; optional — the app proposes states if blank)</span>
					<textarea name="intermediate_states" rows="3" class="textarea textarea-bordered" placeholder="turning toward the seat&#10;beginning to lower"></textarea>
				</label>
				<label class="form-control">
					<span class="label-text">Continuity locks (comma-separated)</span>
					<input name="continuity" class="input input-bordered" placeholder="identity, wardrobe, lighting direction"/>
				</label>
				<div class="card-actions justify-end">
					<button type="submit" class="btn btn-primary">Create plan</button>
				</div>
			</div>
		</form>
	</div>
}

templ SuperShotPage(data SuperShotPageData) {
	@shell(data.Shell, superShotBody(data))
}

templ superShotBody(data SuperShotPageData) {
	<div class="max-w-6xl mx-auto">
		<div class="flex items-start justify-between mb-4">
			<div>
				<h1 class="text-2xl font-bold">{ data.SuperShot.ShotTitle }</h1>
				<p class="opacity-70 text-sm">{ data.SuperShot.Summary }</p>
				<div class="text-xs opacity-70 mt-1">
					{ data.SuperShot.Strategy } · requested { MSecs(data.SuperShot.RequestedDurationMS) }s · planned { MSecs(data.SuperShot.PlannedDurationMS) }s ·
					{ data.SuperShot.ContextMode } · plan v{ data.SuperShot.PlanVersion }
				</div>
			</div>
			<div class="flex items-center gap-2">
				<span class={ "badge", jobStateClass(data.SuperShot.Status) }>{ data.SuperShot.Status }</span>
				if data.SuperShot.Status == "awaiting_approval" || data.SuperShot.Status == "draft" {
					<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/super-shots/" + data.SuperShot.ID + "/approve") }>
						<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
						<input type="hidden" name="revision" value={ IntStr(data.SuperShot.Revision) }/>
						<button type="submit" class="btn btn-primary btn-sm">Approve plan &amp; generate</button>
					</form>
				}
				if data.SuperShot.Status == "failed" || data.SuperShot.Status == "generating_anchors" || data.SuperShot.Status == "generating_segments" {
					<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/super-shots/" + data.SuperShot.ID + "/resume") }>
						<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
						<button type="submit" class="btn btn-sm">Resume</button>
					</form>
				}
				<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/super-shots/" + data.SuperShot.ID + "/cancel") }>
					<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
					<button type="submit" class="btn btn-ghost btn-sm">Cancel</button>
				</form>
			</div>
		</div>

		for _, w := range data.SuperShot.Warnings {
			<div class="alert alert-warning text-sm mb-2">{ w }</div>
		}
		if data.SuperShot.LegacyInvalid {
			<div class="alert alert-error text-sm mb-2">This is a legacy invalid plan: every segment reused the shot's outer endpoints. Re-plan it before generating.</div>
		}

		if data.SuperShot.HasVideo {
			<div class="card bg-base-100 shadow mb-4">
				<div class="card-body">
					<h2 class="text-lg font-semibold">Assembled video</h2>
					<video controls preload="metadata" src={ templ.URL(data.SuperShot.Video.URL) } class="w-full rounded-box border border-base-300"></video>
					<p class="text-xs opacity-70 mt-1">planned { MSecs(data.SuperShot.PlannedDurationMS) }s · measured { MSecs(data.SuperShot.ActualDurationMS) }s</p>
					<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/super-shots/" + data.SuperShot.ID + "/select-video") } class="mt-2">
						<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
						<button type="submit" class="btn btn-sm">Use as the shot's video (Review &amp; Edit)</button>
					</form>
					if len(data.SuperShot.Segments) > 1 {
						<h3 class="text-sm font-semibold mt-3">Join review</h3>
						for i := 0; i < len(data.SuperShot.Segments)-1; i++ {
							<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/super-shots/" + data.SuperShot.ID + "/joins/" + IntStr(i) + "/review") } class="flex items-center gap-2 mt-1">
								<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
								<span class="text-xs opacity-70">join { i + 1 }</span>
								<select name="status" class="select select-bordered select-xs">
									<option value="accepted">accept</option>
									<option value="rejected">reject</option>
									<option value="unreviewed">unreviewed</option>
								</select>
								<input name="notes" class="input input-bordered input-xs flex-1" placeholder="notes"/>
								<button type="submit" class="btn btn-xs">Save</button>
							</form>
						}
					}
				</div>
			</div>
		}

		<h2 class="text-lg font-semibold mb-2">Plan</h2>
		<div class="grid gap-2">
			for i, a := range data.SuperShot.Anchors {
				<div class="card bg-base-100 shadow">
					<div class="card-body py-3">
						<div class="flex items-start justify-between gap-3">
							<div class="min-w-0">
								<div class="text-xs opacity-60">{ MSecs(a.TimeOffsetMS) }s · { a.Kind }</div>
								if a.IsSupplied {
									<div class="text-sm">{ a.State }</div>
								} else {
									<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/super-shots/" + data.SuperShot.ID + "/anchors/" + a.ID) } class="mt-1">
										<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
										<input type="hidden" name="_method" value="PATCH"/>
										<input type="hidden" name="revision" value={ a.Revision }/>
										<textarea name="state" rows="2" class="textarea textarea-bordered textarea-sm w-full">{ a.State }</textarea>
										<button type="submit" class="btn btn-xs mt-1">Save state</button>
									</form>
								}
							</div>
							<div class="flex flex-col items-end gap-1 shrink-0">
								<span class={ "badge badge-sm", jobStateClass(a.Status) }>{ a.Status }</span>
								if a.Error != "" {
									<div class="text-xs text-error max-w-xs text-right">{ a.Error }</div>
								}
								if a.HasAsset {
									if IsVideoAsset(a.Asset) {
										<video controls preload="metadata" src={ templ.URL(a.Asset.URL) } class="w-24 rounded"></video>
									} else {
										<img src={ templ.URL(a.Asset.URL) } class="w-24 rounded" alt="anchor"/>
									}
								} else if !a.IsSupplied {
									<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/super-shots/" + data.SuperShot.ID + "/anchors/" + a.ID + "/generate") }>
										<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
										<button type="submit" class="btn btn-xs">Generate image</button>
									</form>
									if len(data.Images) > 0 {
										<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/super-shots/" + data.SuperShot.ID + "/anchors/" + a.ID + "/attach") } class="flex gap-1 items-center">
											<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
											<select name="asset_id" class="select select-bordered select-xs max-w-[9rem]">
												for _, img := range data.Images {
													<option value={ img.ID }>{ shortID(img.ID) }</option>
												}
											</select>
											<button type="submit" class="btn btn-xs">Attach</button>
										</form>
									}
								}
							</div>
						</div>
					</div>
				</div>
				if i < len(data.SuperShot.Segments) {
					<div class="pl-6">
						@superShotSegmentRow(data, data.SuperShot.Segments[i])
					</div>
				}
			}
		</div>

		if data.SuperShot.Status == "succeeded" || data.SuperShot.HasVideo {
			<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/super-shots/" + data.SuperShot.ID + "/assemble") } class="mt-3">
				<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
				<button type="submit" class="btn btn-sm">Re-assemble</button>
			</form>
		}
	</div>
}

templ superShotSegmentRow(data SuperShotPageData, seg SuperShotSegmentView) {
	<div class="card bg-base-200 shadow-sm">
		<div class="card-body py-3">
			<div class="flex items-start justify-between gap-3">
				<div class="min-w-0">
					<div class="text-xs opacity-60">Segment { seg.Index + 1 } · { MSecs(seg.DurationMS) }s · { seg.Frames } frames · [{ MSecs(seg.StartOffsetMS) }s–{ MSecs(seg.EndOffsetMS) }s)</div>
					<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/super-shots/" + data.SuperShot.ID + "/segments/" + seg.ID) } class="mt-1">
						<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
						<input type="hidden" name="_method" value="PATCH"/>
						<input type="hidden" name="revision" value={ seg.Revision }/>
						<textarea name="action" rows="2" class="textarea textarea-bordered textarea-sm w-full">{ seg.Action }</textarea>
						<button type="submit" class="btn btn-xs mt-1">Save movement prompt</button>
					</form>
				</div>
				<div class="flex flex-col items-end gap-1 shrink-0">
					<span class={ "badge badge-sm", jobStateClass(seg.Status) }>{ seg.Status }</span>
					if seg.Stale {
						<span class="badge badge-error badge-sm">stale</span>
					}
					if seg.Error != "" {
						<div class="text-xs text-error max-w-xs text-right">{ seg.Error }</div>
					}
					if seg.HasFile {
						if IsVideoAsset(seg.Asset) {
							<video controls preload="metadata" src={ templ.URL(seg.Asset.URL) } class="w-32 rounded"></video>
						}
					}
					if seg.Status == "failed" || seg.Stale {
						<form method="post" action={ templ.URL(data.Shell.VideoBase() + "/super-shots/" + data.SuperShot.ID + "/segments/" + seg.ID + "/retry") }>
							<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
							<button type="submit" class="btn btn-xs">Retry</button>
						</form>
					}
				</div>
			</div>
		</div>
	</div>
}
