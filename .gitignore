build/bin/

# --- Node (frontend tooling, if used) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- templ (Go template compiler) ---
# generated *_templ.go files ARE committed so plain `go build` / `wails build`
# work without the templ tool installed
*_templ.txt

# --- Air / dev reload ---
tmp/
*.air.toml

# --- Local app data / media store ---
data/
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.db
/data/media/
/data/temp/
/data/backups/
data/exports/output/

# --- Secrets & credentials ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Editor / IDE ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
logs/

